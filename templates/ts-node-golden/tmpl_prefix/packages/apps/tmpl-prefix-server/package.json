{
  "name": "tmpl-prefix-server",
  "version": "0.1.0",
  "description": "HTTP server deployable application composing domain and adapter packages.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "tmpl-prefix-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "tmpl-prefix-accounts": "workspace:*",
    "tmpl-prefix-config": "workspace:*",
    "tmpl-prefix-core": "workspace:*",
    "tmpl-prefix-http-hono": "workspace:*",
    "tmpl-prefix-http-node": "workspace:*",
    "tmpl-prefix-storage-memory": "workspace:*",
    "tmpl-prefix-telemetry": "workspace:*"
  }
}
