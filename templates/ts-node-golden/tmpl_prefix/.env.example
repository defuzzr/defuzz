# Runtime environment ("development" | "staging" | "production" | "test")
TMPL_PREFIX_ENVIRONMENT=development

# Logical service name emitted in structured telemetry
TMPL_PREFIX_SERVICE_NAME=tmpl-prefix-server

# HTTP bind address
TMPL_PREFIX_HTTP_HOST=127.0.0.1

# HTTP bind port (1..65535)
TMPL_PREFIX_HTTP_PORT=3000

# HTTP adapter implementation ("hono" | "node")
TMPL_PREFIX_HTTP_ADAPTER=hono

# Minimum structured log level ("debug" | "info" | "warn" | "error")
TMPL_PREFIX_LOG_LEVEL=info
