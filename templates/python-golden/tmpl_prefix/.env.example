# Example environment configuration for tmpl-prefix
# Copy to .env to override local defaults. Nested fields use double underscores (__).

TMPL_PREFIX_ENVIRONMENT=development
TMPL_PREFIX_SERVICE_NAME=tmpl-prefix-service
TMPL_PREFIX_HTTP__HOST=127.0.0.1
TMPL_PREFIX_HTTP__PORT=8080
TMPL_PREFIX_HTTP__ADAPTER=fastapi
TMPL_PREFIX_LOG__LEVEL=INFO
